#!/usr/bin/env bash
# claude-pick — Interactive model picker for free-claude-code
# Usage: claude-pick [extra claude args...]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODELS_FILE="${MODELS_FILE:-$SCRIPT_DIR/nvidia_nim_models.json}"
ENV_FILE="${CLAUDE_PICK_ENV_FILE:-$SCRIPT_DIR/.env}"
PORT="${CLAUDE_PICK_PORT:-8082}"
BASE_URL="${ANTHROPIC_BASE_URL:-http://localhost:$PORT}"
OPENROUTER_MODELS_URL="${OPENROUTER_MODELS_URL:-https://openrouter.ai/api/v1/models}"
DEFAULT_LM_STUDIO_BASE_URL="${LM_STUDIO_BASE_URL:-http://localhost:1234/v1}"

if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required." >&2
    exit 1
fi

read_env_value() {
    local key="$1"
    [[ -f "$ENV_FILE" ]] || return 0

    local raw
    raw="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$ENV_FILE" | tail -n 1 || true)"
    raw="${raw#*=}"
    raw="${raw%%#*}"
    raw="$(echo "$raw" | xargs || true)"
    raw="${raw%\"}"
    raw="${raw#\"}"
    raw="${raw%\'}"
    raw="${raw#\'}"
    echo "$raw"
}

parse_models_from_json() {
    python3 -c '
import json, sys
try:
    payload = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for item in payload.get("data", []):
    model_id = item.get("id")
    if model_id:
        print(model_id)
'
}

get_nvidia_models() {
    if [[ ! -f "$MODELS_FILE" ]]; then
        echo "Warning: $MODELS_FILE not found, skipping NVIDIA NIM discovery." >&2
        return 0
    fi

    python3 -c '
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        payload = json.load(f)
    for item in payload.get("data", []):
        model_id = item.get("id")
        if model_id:
            print(model_id)
except Exception as e:
    sys.stderr.write(f"Warning: Failed to parse NVIDIA models from {sys.argv[1]}: {e}\n")
' "$MODELS_FILE" || true
}

get_openrouter_models() {
    if ! command -v curl >/dev/null 2>&1; then
        echo "Warning: curl is required for OpenRouter model discovery, skipping." >&2
        return 0
    fi

    local openrouter_key
    openrouter_key="${OPENROUTER_API_KEY:-$(read_env_value OPENROUTER_API_KEY)}"

    local response=""
    if [[ -n "$openrouter_key" ]]; then
        response="$(curl -fsSL -H "Authorization: Bearer $openrouter_key" "$OPENROUTER_MODELS_URL" 2>/dev/null || true)"
    else
        response="$(curl -fsSL "$OPENROUTER_MODELS_URL" 2>/dev/null || true)"
    fi

    if [[ -z "$response" ]]; then
        echo "Warning: Failed to fetch OpenRouter models, skipping." >&2
        return 0
    fi

    parse_models_from_json <<< "$response" || true
}

get_lmstudio_models() {
    if ! command -v curl >/dev/null 2>&1; then
        echo "Warning: curl is required for LM Studio model discovery, skipping." >&2
        return 0
    fi

    local lm_base
    lm_base="${LM_STUDIO_BASE_URL:-$(read_env_value LM_STUDIO_BASE_URL)}"
    lm_base="${lm_base:-$DEFAULT_LM_STUDIO_BASE_URL}"

    local models_url
    if [[ "$lm_base" == */v1 ]]; then
        models_url="${lm_base}/models"
    else
        models_url="${lm_base}/v1/models"
    fi

    local response=""
    response="$(curl -fsSL "$models_url" 2>/dev/null || true)"
    if [[ -z "$response" ]]; then
        echo "Warning: Failed to query LM Studio models at $models_url, skipping." >&2
        return 0
    fi

    parse_models_from_json <<< "$response" || true
}

main() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "Error: fzf is required for the model picker." >&2
        echo "Install it from: https://github.com/junegunn/fzf" >&2
        exit 1
    fi

    # Determine selection mode: unified by default (NVIDIA NIM + OpenRouter)
    provider_filter="${CLAUDE_PICK_PROVIDER:-}"
    provider_filter="$(echo "$provider_filter" | tr '[:upper:]' '[:lower:]')"

    formatted_entries=()
    prompt="Select a model> "

    case "$provider_filter" in
        nvidia_nim|nvidia|nim)
            prompt="Select an NVIDIA NIM model> "
            nvidia_raw="$(get_nvidia_models)"
            if [[ -n "$nvidia_raw" ]]; then
                while IFS= read -r m; do
                    [[ -n "$m" ]] && formatted_entries+=("$(printf "NVIDIA      | %s\tnvidia_nim/%s" "$m" "$m")")
                done < <(printf "%s\n" "$nvidia_raw" | sed '/^[[:space:]]*$/d' | sort -u)
            fi
            ;;
        open_router|openrouter)
            prompt="Select an OpenRouter model> "
            or_raw="$(get_openrouter_models)"
            if [[ -n "$or_raw" ]]; then
                while IFS= read -r m; do
                    [[ -n "$m" ]] && formatted_entries+=("$(printf "OpenRouter  | %s\topen_router/%s" "$m" "$m")")
                done < <(printf "%s\n" "$or_raw" | sed '/^[[:space:]]*$/d' | sort -u)
            fi
            ;;
        lmstudio|lm_studio|lm-studio)
            prompt="Select an LM Studio model> "
            lms_raw="$(get_lmstudio_models)"
            if [[ -n "$lms_raw" ]]; then
                while IFS= read -r m; do
                    [[ -n "$m" ]] && formatted_entries+=("$(printf "LM Studio   | %s\tlmstudio/%s" "$m" "$m")")
                done < <(printf "%s\n" "$lms_raw" | sed '/^[[:space:]]*$/d' | sort -u)
            fi
            ;;
        ""|all|both|unified)
            prompt="Select a model (NVIDIA / OpenRouter)> "
            # Unified discovery: NVIDIA NIM + OpenRouter
            nvidia_raw="$(get_nvidia_models)"
            if [[ -n "$nvidia_raw" ]]; then
                while IFS= read -r m; do
                    [[ -n "$m" ]] && formatted_entries+=("$(printf "NVIDIA      | %s\tnvidia_nim/%s" "$m" "$m")")
                done < <(printf "%s\n" "$nvidia_raw" | sed '/^[[:space:]]*$/d' | sort -u)
            fi

            or_raw="$(get_openrouter_models)"
            if [[ -n "$or_raw" ]]; then
                while IFS= read -r m; do
                    [[ -n "$m" ]] && formatted_entries+=("$(printf "OpenRouter  | %s\topen_router/%s" "$m" "$m")")
                done < <(printf "%s\n" "$or_raw" | sed '/^[[:space:]]*$/d' | sort -u)
            fi
            ;;
        *)
            echo "Error: Unsupported CLAUDE_PICK_PROVIDER='$provider_filter'." >&2
            echo "Expected one of: nvidia_nim, open_router, lmstudio, or unset for unified mode." >&2
            exit 1
            ;;
    esac

    if [[ ${#formatted_entries[@]} -eq 0 ]]; then
        echo "Error: No models found from available providers." >&2
        exit 1
    fi

    entries_str="$(printf "%s\n" "${formatted_entries[@]}" | sort -u)"

    selection="$(printf "%s\n" "$entries_str" | fzf --delimiter=$'\t' --with-nth=1 --prompt="$prompt" --height=40% --reverse)"

    if [[ -z "${selection:-}" ]]; then
        echo "No model selected." >&2
        exit 1
    fi

    selected_value="$(printf "%s" "$selection" | awk -F'\t' '{print $2}')"
    if [[ -z "$selected_value" ]]; then
        selected_value="$selection"
    fi

    provider="${selected_value%%/*}"
    model="${selected_value#*/}"

    echo "Launching Claude with provider: $provider, model: $model" >&2
    ANTHROPIC_AUTH_TOKEN="freecc:$selected_value" ANTHROPIC_BASE_URL="$BASE_URL" exec claude "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
